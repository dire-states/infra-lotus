[Unit]
Description=Lotus node (calibnet)
After=network-online.target
Wants=network-online.target

[Service]
Environment=LOTSU_PATH=/opt/filecoin/run/fly-lotus
Environment=LOTUS_MINER_PATH=/opt/filecoin/run/fly-genesis-miner
ExecStart=/opt/filecoin/bin/fly-lotus-miner run --nosync
KillSignal=SIGINT
TimeoutStopSec=15min
Restart=on-failure
LimitNOFILE=1048576
