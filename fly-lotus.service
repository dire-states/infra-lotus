[Unit]
Description=Lotus node (calibnet)
After=network-online.target
Wants=network-online.target

[Service]
Environment=LOTUS_PATH=/opt/filecoin/run/fly-lotus
ExecStart=/opt/filecoin/bin/fly-lotus daemon --genesis=/opt/filecoin/build/fly-genesis/dragonfly.car --bootstrap=false
KillSignal=SIGINT
TimeoutStopSec=15min
Restart=on-failure
LimitNOFILE=1048576
